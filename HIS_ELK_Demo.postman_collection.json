{
  "info": {
    "_postman_id": "a7f3c9b2-6d41-4e89-9b14-2c8d1f0e3a51",
    "name": "HIS ELK Stack Demo",
    "description": "Postman collection for the Hospital Information System (HIS) EMR endpoint that writes structured MDC JSON logs for Filebeat, Logstash, Elasticsearch, and Kibana.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "patientId",
      "value": "PAT-1001",
      "type": "string"
    },
    {
      "key": "doctorId",
      "value": "DR-402",
      "type": "string"
    },
    {
      "key": "department",
      "value": "CARDIOLOGY",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Get Patient EMR",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response contains patientId and MDC doctor/department', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.patientId).to.eql(pm.collectionVariables.get('patientId'));",
              "    pm.expect(jsonData.accessedByDoctorId).to.eql(pm.collectionVariables.get('doctorId'));",
              "    pm.expect(jsonData.department).to.eql(pm.collectionVariables.get('department'));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Doctor-Id",
            "value": "{{doctorId}}",
            "type": "text"
          },
          {
            "key": "X-Department",
            "value": "{{department}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/patients/{{patientId}}/emr",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "patients",
            "{{patientId}}",
            "emr"
          ]
        },
        "description": "Retrieves a patient's Electronic Medical Record (EMR) and emits a structured PATIENT_ACCESS JSON log to ./logs/his-application.json."
      },
      "response": []
    }
  ]
}
